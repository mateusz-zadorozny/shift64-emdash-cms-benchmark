{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-cms-pl",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Run the Worker next to the D1 primary (VIE, region EEUR) instead of next
	// to the visitor: a post page makes ~10 sequential D1 queries, so each
	// round trip counts more than the single hop back to the visitor.
	// Warsaw is the closest cloud region to Vienna that we know exists.
	"placement": {
		"region": "gcp:europe-central2"
	},
	"assets": {
		"directory": "./dist",
	},
	// The Worker version is part of the HTML cache key (src/utils/html-cache.ts),
	// so a deploy never serves pages built for the previous assets
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// SESSION also holds the HTML cache generation (key html-cache:generation)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "17e6de7e92fb4d6db3398144158bc6f3"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-cms-pl",
			"database_id": "02c1166e-3ad4-476b-b4e8-3df7a67afdaa"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-cms-pl-media",
		},
	],
	"routes": [
		{ "pattern": "emdashcms.pl", "custom_domain": true }
	],
	// Drives EmDash scheduled publishing and plugin cron (src/worker.ts scheduled())
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true,
	},
}